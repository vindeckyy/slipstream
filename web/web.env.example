# slipstream web console — packaged config reference.
#
# On a `apt install slipstream-web` install you DO NOT edit anything: the systemd --user units wire
# everything automatically —
#   slipstream-web.service sets SLIPSTREAM_MGMT_URL=https://127.0.0.1:47990, NODE_TLS_REJECT_UNAUTHORIZED=0,
#   PORT=3000, HOST=0.0.0.0, and sources:
#     ~/.config/slipstream/mgmt-token    (written by the host's `serve` — the shared bearer token)
#     ~/.config/slipstream/web-password  (written by slipstream-web-init — the console login password)
#
# This file documents the variables for a MANUAL deploy (running `node .output/server/index.mjs`
# yourself). The mgmt API is HTTPS with the host's self-signed loopback cert, so the proxy needs
# NODE_TLS_REJECT_UNAUTHORIZED=0 (its only outbound TLS hop is that loopback connection).
SLIPSTREAM_MGMT_URL=https://127.0.0.1:47990
NODE_TLS_REJECT_UNAUTHORIZED=0
PORT=3000
HOST=0.0.0.0

# Match the host's ~/.config/slipstream/mgmt-token (auto-generated by the host if unset):
SLIPSTREAM_MGMT_TOKEN=

# Console login password (fails closed if unset on the built server):
SLIPSTREAM_UI_PASSWORD=
