Elevated global-priority encode queue — SLIPSTREAM LOCAL PATCH.

Not upstream. PyroWave's wavelet encode runs on the GPU's compute/shader cores, so a GPU-bound
game starves it: `pyrowave_encoder_encode_gpu_synchronous` spikes from ~2 ms to ~15 ms under a
95%+ game load and the stream framerate collapses. NVENC uses the separate encoder ASIC. This
requests a global-priority Vulkan queue on the PyroWave encode device.

`Context::create_device` (the pyrowave path uses plain vkCreateDevice, not the vpCreateDevice
profile path): enable VK_KHR_global_priority (or the EXT alias), chain a
VkDeviceQueueGlobalPriorityCreateInfoKHR into every queue-create-info, and a create loop that tries
`PYROWAVE_QUEUE_PRIORITY` (off|high|realtime, default realtime), then HIGH, then no-priority, downgrading on
VK_ERROR_NOT_PERMITTED_KHR so a refused class NEVER regresses the encoder. Gated on !inherit_info
(only the fresh encoder device). This Granite copy is vendored solely for the PyroWave codec.

Tests on an RTX 4090 did not reduce the spikes because graphics and compute preemption remains
coarse. The fallback is harmless and may help other GPUs or drivers. Reduce the encode GPU cost
(4:2:0/8-bit) or use H.265 for a GPU-saturated game.

diff --git a/crates/pyrowave-sys/vendor/pyrowave/Granite/vulkan/context.cpp b/crates/pyrowave-sys/vendor/pyrowave/Granite/vulkan/context.cpp
index 5257fc33..479eeded 100644
--- a/crates/pyrowave-sys/vendor/pyrowave/Granite/vulkan/context.cpp
+++ b/crates/pyrowave-sys/vendor/pyrowave/Granite/vulkan/context.cpp
@@ -2115,6 +2115,50 @@ bool Context::create_device(VkPhysicalDevice gpu_, VkSurfaceKHR surface,
 		vpGetProfileProperties(profile.profile, &props);
 #endif
 
+	// SLIPSTREAM PATCH (patches/0005-global-priority-queue.patch, NOT upstream): request a high
+	// global-priority queue so PyroWave's compute-shader encode can PREEMPT a GPU-bound game on
+	// the shared shader cores. A global-priority queue is the actual NVIDIA compute-
+	// preemption lever. `PYROWAVE_QUEUE_PRIORITY` = off | high | realtime (default realtime). The
+	// device-create loop below downgrades on NOT_PERMITTED, so a refused class NEVER fails the
+	// encoder; it just runs at default priority. Only the fresh encoder device (no inherit_info)
+	// is affected; this Granite copy is vendored solely for the PyroWave codec.
+	Util::SmallVector<VkQueueGlobalPriorityKHR> ss_priority_candidates;
+	Util::SmallVector<VkDeviceQueueGlobalPriorityCreateInfoKHR> ss_global_priority_infos;
+	if (!inherit_info)
+	{
+		const char *ss_gp_ext = nullptr;
+		if (has_extension(VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME))
+			ss_gp_ext = VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME;
+		else if (has_extension(VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME))
+			ss_gp_ext = VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME;
+		std::string ss_prio;
+		if (!Util::get_environment("PYROWAVE_QUEUE_PRIORITY", ss_prio))
+			ss_prio = "realtime";
+		for (auto &ss_ch : ss_prio)
+			if (ss_ch >= 'A' && ss_ch <= 'Z')
+				ss_ch = char(ss_ch + 32);
+		if (ss_gp_ext && ss_prio != "off")
+		{
+			if (ss_prio == "high")
+			{
+				ss_priority_candidates.push_back(VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR);
+			}
+			else
+			{
+				ss_priority_candidates.push_back(VK_QUEUE_GLOBAL_PRIORITY_REALTIME_KHR);
+				ss_priority_candidates.push_back(VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR);
+			}
+			enabled_extensions.push_back(ss_gp_ext);
+			ss_global_priority_infos.resize(queue_infos.size());
+			for (size_t ss_i = 0; ss_i < queue_infos.size(); ss_i++)
+			{
+				ss_global_priority_infos[ss_i] = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_KHR };
+				ss_global_priority_infos[ss_i].globalPriority = ss_priority_candidates.front();
+				queue_infos[ss_i].pNext = &ss_global_priority_infos[ss_i];
+			}
+		}
+	}
+
 	if (inherit_info)
 	{
 		device_info.enabledExtensionCount = inherit_info->enabledExtensionCount;
@@ -2144,8 +2188,41 @@ bool Context::create_device(VkPhysicalDevice gpu_, VkSurfaceKHR surface,
 			if (device == VK_NULL_HANDLE)
 				return false;
 		}
-		else if (vkCreateDevice(gpu, &device_info, nullptr, &device) != VK_SUCCESS)
-			return false;
+		else
+		{
+			// SLIPSTREAM: try the requested global-priority class, downgrade through the
+			// candidate list on NOT_PERMITTED, then finally create with no global priority.
+			VkResult ss_res;
+			if (ss_priority_candidates.empty())
+			{
+				ss_res = vkCreateDevice(gpu, &device_info, nullptr, &device);
+			}
+			else
+			{
+				ss_res = VK_ERROR_NOT_PERMITTED_KHR;
+				for (size_t ss_a = 0; ss_a < ss_priority_candidates.size(); ss_a++)
+				{
+					for (auto &ss_gp : ss_global_priority_infos)
+						ss_gp.globalPriority = ss_priority_candidates[ss_a];
+					ss_res = vkCreateDevice(gpu, &device_info, nullptr, &device);
+					if (ss_res != VK_ERROR_NOT_PERMITTED_KHR)
+						break;
+					LOGW("PyroWave: global queue priority %u not permitted; downgrading.\n",
+						unsigned(ss_priority_candidates[ss_a]));
+				}
+				if (ss_res == VK_ERROR_NOT_PERMITTED_KHR)
+				{
+					for (auto &ss_qi : queue_infos)
+						ss_qi.pNext = nullptr;
+					ss_res = vkCreateDevice(gpu, &device_info, nullptr, &device);
+					LOGW("PyroWave: all global queue priorities refused; default priority.\n");
+				}
+				else
+					LOGI("PyroWave: encode device created with an elevated global queue priority.\n");
+			}
+			if (ss_res != VK_SUCCESS)
+				return false;
+		}
 	}
 
 	if (inherit_info)
