{
	"name": "@slipstream/host",
	"version": "0.1.2",
	"packageManager": "bun@1.3.14",
	"description": "TypeScript SDK for the slipstream streaming host: typed management-API client + lifecycle event stream, built on Effect.",
	"type": "module",
	"license": "MIT OR Apache-2.0",
	"homepage": "https://github.com/vindeckyy/slipstream/tree/main/sdk",
	"repository": {
		"type": "git",
		"url": "https://github.com/vindeckyy/slipstream.git",
		"directory": "sdk"
	},
	"bugs": {
		"url": "https://github.com/vindeckyy/slipstream/issues"
	},
	"keywords": ["slipstream", "game-streaming", "automation", "sdk", "effect"],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./effect": {
			"types": "./dist/effect.d.ts",
			"default": "./dist/effect.js"
		}
	},
	"bin": {
		"slipstream-scripting": "./dist/runner-cli.js"
	},
	"files": ["dist", "README.md"],
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"prepare": "bun2nix -o bun.nix",
		"gen": "openapigen --spec ../api/openapi.json --name Slipstream --format httpclient > src/gen/slipstream.ts",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"test": "bun test",
		"runner": "bun src/runner-cli.ts",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"effect": "^4.0.0-beta.102"
	},
	"devDependencies": {
		"effect": "^4.0.0-beta.102",
		"@effect/openapi-generator": "4.0.0-beta.104",
		"@effect/platform-node": "4.0.0-beta.102",
		"@types/bun": "^1.3.0",
		"bun2nix": "2.1.2",
		"typescript": "^5.9.3"
	},
	"optionalDependencies": {
		"undici": "^7.0.0"
	}
}
