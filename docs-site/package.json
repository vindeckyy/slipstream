{
  "name": "slipstream-docs",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "Slipstream documentation site - Fumadocs on TanStack Start",
  "scripts": {
    "dev": "vite dev --port 3001",
    "prebuild": "bun tools/sync-openapi.mjs",
    "build": "vite build",
    "check:links": "bun tools/check-doc-links.mjs",
    "check:openapi": "cmp -s ../api/openapi.json public/openapi.json",
    "start": "bun run .output/server/index.mjs",
    "lint": "tsc --noEmit",
    "build:pages": "PAGES_BASE_PATH=/slipstream/ vite build && bun tools/check-pages-output.mjs",
    "check:pages": "bun tools/check-pages-output.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@scalar/api-reference-react": "^0.9.60",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "fumadocs-core": "^16.14.0",
    "fumadocs-ui": "^16.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "dompurify": "^3.4.12",
    "fast-uri": "^3.1.3",
    "immutable": "^4.3.9",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.25",
    "tar": "^7.5.22",
    "undici": "^7.28.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fumadocs-mdx": "^15.2.1",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.2.12",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
