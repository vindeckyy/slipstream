{
  "name": "slipstream-decky",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.4",
  "description": "SteamOS / Steam Deck Gaming-Mode launcher for the Slipstream streaming client.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "package": "pnpm build && bash scripts/package.sh",
    "deploy": "bash scripts/deploy.sh",
    "test": "pnpm typecheck"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "slipstream",
    "game-streaming"
  ],
  "author": "enrico",
  "license": "Apache-2.0 OR MIT",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.62.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.62.4",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
