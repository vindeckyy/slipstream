{
  "$comment": "Cross-language contract for the slipstream:// grammar (design/client-deep-links.md §2). The Rust (crates/pf-client-core/src/deeplink.rs), Swift (SlipstreamShared/DeepLink.swift) and Kotlin parsers each run every case in their own test suite, so the three cannot drift into three different security postures. `expect` fields absent from a case must parse as absent; `emit` is the canonical URL the parsed link must serialise back to (note that pf:// never round-trips — it is an accepted input alias, never an output). `error` is the stable refusal code, not a message.",
  "version": 1,
  "cases": [
    {
      "name": "apple-shipped-uuid",
      "url": "slipstream://connect/11111111-2222-4333-8444-555555555555",
      "expect": {
        "route": "connect",
        "host_ref": "11111111-2222-4333-8444-555555555555"
      },
      "emit": "slipstream://connect/11111111-2222-4333-8444-555555555555"
    },
    {
      "name": "apple-shipped-launch",
      "url": "slipstream://connect/11111111-2222-4333-8444-555555555555?launch=steam:570",
      "expect": {
        "route": "connect",
        "host_ref": "11111111-2222-4333-8444-555555555555",
        "launch": "steam:570"
      },
      "emit": "slipstream://connect/11111111-2222-4333-8444-555555555555?launch=steam:570"
    },
    {
      "name": "bare-reference-without-a-route",
      "url": "slipstream://11111111-2222-4333-8444-555555555555",
      "expect": {
        "route": "connect",
        "host_ref": "11111111-2222-4333-8444-555555555555"
      }
    },
    {
      "name": "scheme-case-is-ignored",
      "url": "Slipstream://CONNECT/Desk",
      "expect": {
        "route": "connect",
        "host_ref": "Desk"
      }
    },
    {
      "name": "pf-alias-parses-but-is-never-emitted",
      "url": "pf://connect/Desk",
      "expect": {
        "route": "connect",
        "host_ref": "Desk"
      },
      "emit": "slipstream://connect/Desk"
    },
    {
      "name": "trailing-slash-tolerated",
      "url": "slipstream://connect/Desk/",
      "expect": {
        "route": "connect",
        "host_ref": "Desk"
      }
    },
    {
      "name": "address-reference-with-port",
      "url": "slipstream://connect/192.168.1.50:9777",
      "expect": {
        "route": "connect",
        "host_ref": "192.168.1.50:9777"
      }
    },
    {
      "name": "percent-encoded-host-name",
      "url": "slipstream://connect/Wohnzimmer%20PC",
      "expect": {
        "route": "connect",
        "host_ref": "Wohnzimmer PC"
      },
      "emit": "slipstream://connect/Wohnzimmer%20PC"
    },
    {
      "name": "self-emitted-full-form",
      "url": "slipstream://connect/11111111-2222-4333-8444-555555555555?fp=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc&host=192.168.1.50:7777&launch=steam:570&profile=aaaaaaaaaaaa",
      "expect": {
        "route": "connect",
        "host_ref": "11111111-2222-4333-8444-555555555555",
        "fp": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "host_addr": "192.168.1.50",
        "host_port": 7777,
        "launch": "steam:570",
        "profile": "aaaaaaaaaaaa"
      },
      "emit": "slipstream://connect/11111111-2222-4333-8444-555555555555?fp=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc&host=192.168.1.50:7777&launch=steam:570&profile=aaaaaaaaaaaa"
    },
    {
      "name": "fingerprint-is-normalised-to-lowercase",
      "url": "slipstream://connect/Desk?fp=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "fp": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "name": "host-parameter-defaults-to-9777",
      "url": "slipstream://connect/Desk?host=192.168.1.50",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "host_addr": "192.168.1.50",
        "host_port": 9777
      }
    },
    {
      "name": "host-parameter-ipv6-bracketed",
      "url": "slipstream://connect/Desk?host=%5B::1%5D:7777",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "host_addr": "::1",
        "host_port": 7777
      }
    },
    {
      "name": "wake-route-parses",
      "url": "slipstream://wake/Desk",
      "expect": {
        "route": "wake",
        "host_ref": "Desk"
      }
    },
    {
      "name": "browse-route-parses",
      "url": "slipstream://browse/Desk",
      "expect": {
        "route": "browse",
        "host_ref": "Desk"
      }
    },
    {
      "name": "profile-by-name",
      "url": "slipstream://connect/Desk?profile=Work",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "profile": "Work"
      }
    },
    {
      "name": "unknown-parameters-are-ignored",
      "url": "slipstream://connect/Desk?bogus=1&launch=steam:1",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "launch": "steam:1"
      }
    },
    {
      "name": "empty-parameter-is-absent-not-an-error",
      "url": "slipstream://connect/Desk?launch=&profile=Work",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "profile": "Work"
      }
    },
    {
      "name": "first-occurrence-of-a-parameter-wins",
      "url": "slipstream://connect/Desk?fp=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa&fp=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "fp": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "name": "fragment-is-dropped",
      "url": "slipstream://connect/Desk#whatever",
      "expect": {
        "route": "connect",
        "host_ref": "Desk"
      }
    },
    {
      "name": "a-query-hidden-in-the-fragment-is-not-parsed",
      "url": "slipstream://connect/Desk#?launch=steam:570",
      "expect": {
        "route": "connect",
        "host_ref": "Desk"
      }
    },
    {
      "name": "non-ascii-label-survives-the-round-trip",
      "url": "slipstream://connect/Desk?name=B%C3%BCro%20%C2%B7%20Mac",
      "expect": {
        "route": "connect",
        "host_ref": "Desk",
        "name": "Büro · Mac"
      },
      "emit": "slipstream://connect/Desk?name=B%C3%BCro%20%C2%B7%20Mac"
    },
    {
      "name": "another-scheme-is-not-ours",
      "url": "https://example.com/connect/Desk",
      "error": "not-our-scheme"
    },
    {
      "name": "scheme-without-authority-is-not-ours",
      "url": "slipstream:/connect/Desk",
      "error": "not-our-scheme"
    },
    {
      "name": "pairing-is-never-a-route",
      "url": "slipstream://pair/1234",
      "error": "pair-refused"
    },
    {
      "name": "bare-pair-is-refused-too",
      "url": "slipstream://pair",
      "error": "pair-refused"
    },
    {
      "name": "undefined-route-refuses",
      "url": "slipstream://teardown/Desk",
      "error": "unknown-route"
    },
    {
      "name": "route-without-a-host-reference",
      "url": "slipstream://connect/",
      "error": "missing-host-ref"
    },
    {
      "name": "bare-route-word-is-not-a-host-reference",
      "url": "slipstream://connect",
      "error": "missing-host-ref"
    },
    {
      "name": "truncated-percent-escape",
      "url": "slipstream://connect/Desk%2",
      "error": "bad-escape"
    },
    {
      "name": "non-hex-percent-escape",
      "url": "slipstream://connect/De%zzsk",
      "error": "bad-escape"
    },
    {
      "name": "invalid-utf8-escape",
      "url": "slipstream://connect/De%FFsk",
      "error": "bad-escape"
    },
    {
      "name": "newline-smuggled-into-the-reference",
      "url": "slipstream://connect/Desk%0A",
      "error": "control-char"
    },
    {
      "name": "nul-byte-smuggled-into-the-reference",
      "url": "slipstream://connect/Desk%00",
      "error": "control-char"
    },
    {
      "name": "fingerprint-too-short",
      "url": "slipstream://connect/Desk?fp=abc",
      "error": "bad-fingerprint"
    },
    {
      "name": "fingerprint-not-hex",
      "url": "slipstream://connect/Desk?fp=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz",
      "error": "bad-fingerprint"
    },
    {
      "name": "host-parameter-with-an-unparsable-port",
      "url": "slipstream://connect/Desk?host=box:notaport",
      "error": "bad-host-param"
    },
    {
      "name": "launch-id-with-a-space",
      "url": "slipstream://connect/Desk?launch=steam%20570",
      "error": "bad-launch-id"
    },
    {
      "name": "launch-id-with-a-quote",
      "url": "slipstream://connect/Desk?launch=%22evil%22",
      "error": "bad-launch-id"
    },
    {
      "name": "launch-id-with-a-shell-metacharacter",
      "url": "slipstream://connect/Desk?launch=steam:570%60id%60",
      "error": "bad-launch-id"
    },
    {
      "name": "launch-id-over-the-cap",
      "url": "slipstream://connect/Desk?launch=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "error": "param-too-long"
    },
    {
      "name": "profile-reference-over-the-cap",
      "url": "slipstream://connect/Desk?profile=ppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp",
      "error": "param-too-long"
    },
    {
      "name": "name-over-the-cap",
      "url": "slipstream://connect/Desk?name=nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn",
      "error": "param-too-long"
    },
    {
      "name": "host-reference-over-the-cap",
      "url": "slipstream://connect/hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh",
      "error": "param-too-long"
    },
    {
      "name": "url-over-the-total-cap",
      "url": "slipstream://connect/Desk?",
      "error": "too-long"
    }
  ]
}
