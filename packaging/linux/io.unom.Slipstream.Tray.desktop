[Desktop Entry]
Type=Application
Name=slipstream host status
Comment=Tray icon showing the slipstream host service status
# --autostart exits silently unless this user actually runs a host (~/.config/slipstream exists or
# the slipstream-host user unit is enabled) — the package installs this for every desktop user.
Exec=/usr/bin/slipstream-tray --autostart
Icon=slipstream-tray
# Autostart-only: not a launcher entry (launch it from a terminal as `slipstream-tray` if wanted).
NoDisplay=true
# KDE: start after plasmashell so the StatusNotifierWatcher is up (harmless elsewhere; the tray
# also waits for the watcher when started early).
X-KDE-autostart-after=panel
X-GNOME-Autostart-enabled=true
Categories=Network;Utility;
