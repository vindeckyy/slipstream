# slipstream host configuration (~/.config/slipstream/host.env) — consumed by slipstream-host.service.

# Session / compositor environment (headless KWin example).
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WAYLAND_DISPLAY=wayland-kde
XDG_CURRENT_DESKTOP=KDE

# Video source: `virtual` creates a per-client virtual output at the client's exact
# resolution+refresh (the flagship mode); `portal` captures an existing monitor.
SLIPSTREAM_VIDEO_SOURCE=virtual

# GPU zero-copy capture (EGL/Vulkan → CUDA → NVENC). Falls back to CPU automatically.
SLIPSTREAM_ZEROCOPY=1

# Optional overrides (apps.json is the primary mechanism for per-app settings):
#SLIPSTREAM_COMPOSITOR=kwin          # kwin | mutter | gamescope | wlroots
#SLIPSTREAM_GAMESCOPE_APP=vkcube     # nested command for ad-hoc gamescope sessions
#SLIPSTREAM_INPUT_BACKEND=libei      # wlr | libei | gamescope | uinput
#SLIPSTREAM_FEC_PCT=20               # video FEC overhead percent
#SLIPSTREAM_PERF=1                   # per-stage timing logs
#RUST_LOG=info
